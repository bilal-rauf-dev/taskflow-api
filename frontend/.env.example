# Backend API origin (no trailing slash, no /api/v1 suffix).
#
# Optional. Leave this unset for a frontend-only deploy (e.g. Vercel with no
# backend) - the app then runs entirely in Guest Mode, saving everything to
# the browser's local storage instead of a server. When it is set, the app
# still offers Guest Mode as a fallback if this URL turns out to be
# unreachable (see src/hooks/useBackendStatus.js).
VITE_API_URL=http://localhost:5000
